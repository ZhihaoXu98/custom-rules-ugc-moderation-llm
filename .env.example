# Copy to .env (gitignored) and fill in real values.
# Do NOT commit .env — verify with `git status` before any commit.

# Frontier APIs (Week 2 baselines + Week 9 calibrated judge)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Hugging Face — needed Week 4 to pull Qwen 2.5 7B Instruct base; Week 6 to push fine-tuned model
# Create at https://huggingface.co/settings/tokens (write scope)
HF_TOKEN=

# Weights & Biases — needed Week 4 for training runs
# Get at https://wandb.ai/authorize
WANDB_API_KEY=

# Langfuse — Week 8+ (observability for the FastAPI demo)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
